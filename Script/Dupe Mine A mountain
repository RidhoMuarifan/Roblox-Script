local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- Mencari Remote
local function findRemote(name)
    local folder = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:WaitForChild("Remotes", 10)
    if not folder then return nil end
    return folder:FindFirstChild(name) or folder:WaitForChild(name, 5)
end

local DigRequest = findRemote("DigRequest")
local HoldComplete = findRemote("CrystalHoldComplete")
local CrystalDropRequest = findRemote("CrystalDropRequest")

-- ⚙️ Konfigurasi Global & State
local State = {
    AutoSwing = false,
    CameraNoclip = false,
    InstantMine = false,
    NoRagdoll = false,
    NoFallDamage = false,
    BurstCount = 6,
    ReachDistance = 12,
    SwingCooldown = 0.03,
    DupeDelay = 2.0
}

-- Parameter Glide & Area Pickup
local PICK = {
    range = 13,
    cooldown = 0.04,
    restore = 0.2,
    burst = 8,
    retry = 0.15,
    forget = 5,
    pad = 4,
}

local GLIDE_SPEED = 350
local AIM_RATE = 9
local RESPONSE = 200

-- State Drop & Scanner World
local ScannedCrystals = {}
local DropdownMap = {}
local SelectedTargetKey = nil
local SelectedRarityFilter = "All"
local IsGliding = false
local CurrentGlideThread = nil
local NoclipConnection = nil
local InitialCFrame = nil

-- State Selective Dropper
local BackpackDropCrystals = {}
local DropdownDropMap = {}
local SelectedDropGroup = nil
local DropAmount = 1
local IsDropping = false

local lastPickup = 0
local claimed = {}
local originalPrompts = {}

-- Alignment Mover Variables
local MoverPosition, MoverOrientation, MoverAttachment

-- Filter Tier Urutan Quasar Teratas -> Common Terbawah
local TIER_LIST = {"All", "Quasar", "Pulsar", "Empiris", "Mythic", "Legendary", "Epic", "Rare", "Uncommon", "Common"}

local pickupParams = OverlapParams.new()
pickupParams.FilterType = Enum.RaycastFilterType.Exclude
pcall(function()
    pickupParams.MaxParts = 300
    pickupParams.RespectCanCollide = false
end)

-- ==========================================
-- HELPER FUNCTIONS
-- ==========================================
local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function cleanItemName(fullName)
    return fullName:gsub("%s*%[%d+%.?%d*kg%]", "")
end

local function getAttr(inst, name)
    local ok, val = pcall(inst.GetAttribute, inst, name)
    return ok and val or nil
end

local function isCrystal(inst)
    if not inst then return false end
    if inst:IsA("BasePart") then
        if getAttr(inst, "Value") ~= nil or getAttr(inst, "CrystalName") ~= nil or inst.Name:find("Crystal", 1, true) ~= nil then
            return true
        end
    end
    if inst:IsA("Model") or inst:IsA("Tool") then
        if getAttr(inst, "Value") ~= nil or getAttr(inst, "CrystalName") ~= nil or inst.Name:find("Crystal", 1, true) ~= nil then
            return true
        end
        local handle = inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart")
        if handle and (getAttr(handle, "Value") ~= nil or handle.Name:find("Crystal", 1, true) ~= nil) then
            return true
        end
    end
    return false
end

local function isCrystalTool(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local okValue, val = pcall(tool.GetAttribute, tool, "Value")
    local okTier, tier = pcall(tool.GetAttribute, tool, "Tier")
    
    if (okValue and val ~= nil) or (okTier and tier ~= nil) or tool.Name:find("Crystal", 1, true) ~= nil then
        return true
    end
    return false
end

local function getCrystalPart(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") or inst:IsA("Tool") then
        return inst.PrimaryPart or inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function crystalPrompt(inst)
    if not inst then return nil end
    local ok, prompt = pcall(inst.FindFirstChildOfClass, inst, "ProximityPrompt")
    if not (ok and prompt) then
        ok, prompt = pcall(inst.FindFirstChildWhichIsA, inst, "ProximityPrompt", true)
    end
    return (ok and prompt) and prompt or nil
end

-- ==========================================
-- NOCLIP & GLIDE ENGINE
-- ==========================================
local function enableNoclip()
    if NoclipConnection then return end
    NoclipConnection = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if char and IsGliding then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function disableNoclip()
    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end
end

local function detachMovers()
    if MoverPosition then pcall(function() MoverPosition:Destroy() end) MoverPosition = nil end
    if MoverOrientation then pcall(function() MoverOrientation:Destroy() end) MoverOrientation = nil end
    if MoverAttachment then pcall(function() MoverAttachment:Destroy() end) MoverAttachment = nil end
end

local function attachMovers(root)
    detachMovers()
    pcall(function()
        local att = Instance.new("Attachment")
        att.Name = "CustomGlideAtt"
        att.Parent = root

        local pos = Instance.new("AlignPosition")
        pos.Mode = Enum.PositionAlignmentMode.OneAttachment
        pos.Attachment0 = att
        pos.MaxForce = 1e7
        pos.Responsiveness = RESPONSE
        pos.Position = root.Position
        pos.Parent = root

        local ori = Instance.new("AlignOrientation")
        ori.Mode = Enum.OrientationAlignmentMode.OneAttachment
        ori.Attachment0 = att
        ori.MaxTorque = 1e7
        ori.Responsiveness = RESPONSE
        ori.CFrame = root.CFrame.Rotation
        ori.Parent = root

        MoverAttachment = att
        MoverPosition = pos
        MoverOrientation = ori
    end)
end

local function glideToCFrame(targetCFrame, deltaTime)
    local root = getRoot()
    if not root then return end
    
    if not MoverPosition or MoverPosition.Parent ~= root then
        attachMovers(root)
    end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = true end

    local currentPos = MoverPosition.Position
    local delta = targetCFrame.Position - currentPos
    local span = GLIDE_SPEED * deltaTime

    local nextPos
    if delta.Magnitude <= math.max(span, 0.35) then
        nextPos = targetCFrame.Position
    else
        nextPos = currentPos + (delta.Unit * span)
    end

    MoverPosition.Position = nextPos
    MoverOrientation.CFrame = MoverOrientation.CFrame:Lerp(targetCFrame.Rotation, 1 - math.exp(-AIM_RATE * deltaTime))
end

local function stopGlide()
    detachMovers()
    disableNoclip()
    IsGliding = false
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

-- ==========================================
-- AUTO PICKUP AREA
-- ==========================================
local function firePrompt(prompt)
    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.Enabled = true
        prompt.MaxActivationDistance = 1000
    end)

    local fired = false
    if typeof(fireproximityprompt) == "function" then
        fired = pcall(fireproximityprompt, prompt, 1)
        if not fired then fired = pcall(fireproximityprompt, prompt) end
    end

    if not fired then
        fired = pcall(function()
            prompt:InputHoldBegin()
            prompt:InputHoldEnd()
        end)
    end

    return fired
end

local function grabCrystalOriginal(inst)
    local sent = false
    if HoldComplete then
        sent = pcall(function() HoldComplete:FireServer(inst) end)
    end
    local prompt = crystalPrompt(inst)
    if prompt and prompt.Parent and firePrompt(prompt) then
        sent = true
    end
    return sent
end

local function executeAreaPickup()
    local now = os.clock()
    if now - lastPickup < PICK.cooldown then return end

    local root = getRoot()
    if not root then return end

    for inst, stamp in pairs(claimed) do
        if now - stamp >= PICK.forget or not inst.Parent then
            claimed[inst] = nil
        end
    end

    pickupParams.FilterDescendantsInstances = { LocalPlayer.Character or LocalPlayer }

    local ok, hits = pcall(function()
        return Workspace:GetPartBoundsInRadius(root.Position, PICK.range + PICK.pad, pickupParams)
    end)

    if not ok or not hits then return end

    local grabs = 0
    for _, part in ipairs(hits) do
        if grabs >= PICK.burst then break end

        if part and part.Parent and isCrystal(part) and getAttr(part, "Collected") ~= true then
            local claimStamp = claimed[part]
            if not claimStamp or (now - claimStamp >= PICK.retry) then
                claimed[part] = now
                if grabCrystalOriginal(part) then
                    grabs = grabs + 1
                end
            end
        end
    end

    if grabs > 0 then
        lastPickup = now
    end
end

local function scanWorld()
    table.clear(ScannedCrystals)
    local processedInstances = {}

    local function processObject(child)
        if not child then return end
        local part = getCrystalPart(child) or child
        
        if processedInstances[part] then return end

        if isCrystal(child) then
            processedInstances[part] = true
            local rawName = getAttr(child, "CrystalName") or child.Name
            local rarity = getAttr(child, "TierName") or "Crystal"
            
            if SelectedRarityFilter == "All" or rarity:lower() == SelectedRarityFilter:lower() then
                local cleanName = string.format("[%s] %s", rarity, cleanItemName(rawName))
                
                if not ScannedCrystals[cleanName] then
                    ScannedCrystals[cleanName] = { Count = 1, Instances = {part} }
                else
                    ScannedCrystals[cleanName].Count = ScannedCrystals[cleanName].Count + 1
                    table.insert(ScannedCrystals[cleanName].Instances, part)
                end
            end
        end
    end

    local function searchContainer(container)
        if not container then return end
        for _, child in ipairs(container:GetChildren()) do
            processObject(child)
            if child:IsA("Folder") or child:IsA("Model") then
                for _, inner in ipairs(child:GetChildren()) do
                    processObject(inner)
                end
            end
        end
    end

    local dropped = Workspace:FindFirstChild("DroppedCrystals")
    local crystals = Workspace:FindFirstChild("Crystals")
    local things = Workspace:FindFirstChild("Things")

    if dropped then searchContainer(dropped) end
    if crystals then searchContainer(crystals) end
    if things then
        searchContainer(things:FindFirstChild("DroppedCrystals"))
        searchContainer(things:FindFirstChild("Crystals"))
    end

    for _, child in ipairs(Workspace:GetChildren()) do
        if child ~= dropped and child ~= crystals and child ~= things then
            processObject(child)
        end
    end
end

-- ==========================================
-- SELECTIVE DROPPER LOGIC
-- ==========================================
local function scanBackpackForDrop()
    table.clear(BackpackDropCrystals)
    
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local character = LocalPlayer.Character
    
    local function processContainer(container)
        if not container then return end
        for _, item in ipairs(container:GetChildren()) do
            if isCrystalTool(item) then
                local rawName = cleanItemName(item.Name)
                local rarity = getAttr(item, "TierName")
                
                local formattedName
                if rarity and rarity ~= "" then
                    formattedName = string.format("[%s] %s", rarity, rawName)
                else
                    formattedName = rawName
                end
                
                local fullName = item.Name
                
                if not BackpackDropCrystals[formattedName] then
                    BackpackDropCrystals[formattedName] = { Count = 1, FullNames = {fullName} }
                else
                    BackpackDropCrystals[formattedName].Count = BackpackDropCrystals[formattedName].Count + 1
                    table.insert(BackpackDropCrystals[formattedName].FullNames, fullName)
                end
            end
        end
    end

    processContainer(backpack)
    processContainer(character)
end

local function dropCrystalsViaRemote(groupName, amount)
    if not CrystalDropRequest then
        Library:Notify("Error: Remote 'CrystalDropRequest' tidak ditemukan!", 3)
        return
    end

    local data = BackpackDropCrystals[groupName]
    if not data or #data.FullNames == 0 then
        Library:Notify("Gagal Drop: Kristal tidak ditemukan di backpack!", 3)
        return
    end

    local totalAvailable = #data.FullNames
    local toDrop = math.min(amount, totalAvailable)
    
    IsDropping = true
    local droppedCount = 0

    task.spawn(function()
        for i = 1, toDrop do
            if not IsDropping then break end

            local fullName = data.FullNames[#data.FullNames]
            if fullName then
                pcall(function()
                    CrystalDropRequest:FireServer(fullName)
                end)

                droppedCount = droppedCount + 1
                table.remove(data.FullNames, #data.FullNames)
            end
            
            task.wait(0.05)
        end

        IsDropping = false
        Library:Notify(string.format("Selesai Drop %d/x%d %s", droppedCount, totalAvailable, groupName), 3)
    end)
end

