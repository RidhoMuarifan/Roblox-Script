local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Global Connections & Config Storage
local Connections = {}
local Config = {
    AimbotEnabled = false,
    TeamCheck = true,
    AimbotSmoothness = 0.15, -- 0.05 (sangat halus) s/d 1 (langsung snap)
    FovRadius = 120,
    ShowFovCircle = false,
    
    EspEnabled = false,
    EspTeamCheck = true
}

local ScriptRunning = true

-- Cleanup Script Lama (mencegah tumpuk UI/connection)
if _G.NeftishRivalsCleanup then
    pcall(_G.NeftishRivalsCleanup)
end

-- Safely Get Target Parent Gui
local TargetParent = CoreGui
if not pcall(function() local _ = CoreGui.Name end) then
    TargetParent = LocalPlayer:WaitForChild("PlayerGui")
end

-- Destroy UI Lama jika ada
for _, child in pairs(TargetParent:GetChildren()) do
    if child.Name == "Neftish_RivalsHub" or child.Name == "Neftish_RivalsFloatBtn" then
        child:Destroy()
    end
end

-- ==========================================
-- LOGIKA TEAM CHECK KHUSUS GAME RIVALS & GENERAL
-- ==========================================
local function IsEnemy(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return false end
    
    -- 1. Pengecekan Roblox Standard Team
    if LocalPlayer.Team and targetPlayer.Team then
        return targetPlayer.Team ~= LocalPlayer.Team
    end
    
    -- 2. Pengecekan Custom Folder / Highlight di Rivals (jika tidak pakai default Teams)
    local myChar = LocalPlayer.Character
    local targetChar = targetPlayer.Character
    if myChar and targetChar then
        -- Cek jika ada atribut/folder khusus tim
        if myChar.Parent ~= workspace and myChar.Parent == targetChar.Parent then
            return false -- Satu folder tim yang sama
        end
    end
    
    return true -- Default: Anggap musuh jika tidak ada sistem tim yang aktif
end

-- ==========================================
-- LOGIKA AIMBOT & FOV CIRCLE
-- ==========================================
local FovCircle = Drawing.new("Circle")
FovCircle.Color = Color3.fromRGB(255, 50, 50)
FovCircle.Thickness = 1.5
FovCircle.Filled = false
FovCircle.Transparency = 1
FovCircle.NumSides = 60
FovCircle.Visible = false

local function GetClosestEnemyInFOV()
    local closestTarget = nil
    local shortestDistance = Config.FovRadius
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not Config.TeamCheck or IsEnemy(player) then
                local char = player.Character
                local head = char and char:FindFirstChild("Head")
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if head and hum and hum.Health > 0 then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local distanceToMouse = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if distanceToMouse < shortestDistance then
                            shortestDistance = distanceToMouse
                            closestTarget = head
                        end
                    end
                end
            end
        end
    end

    return closestTarget
end

-- RenderStepped Loop untuk Aimbot & FOV Circle
table.insert(Connections, RunService.RenderStepped:Connect(function()
    -- Update FOV Circle Position
    local mousePos = UserInputService:GetMouseLocation()
    FovCircle.Position = mousePos
    FovCircle.Radius = Config.FovRadius
    FovCircle.Visible = Config.ShowFovCircle and ScriptRunning

    -- Execution Aimbot
    if Config.AimbotEnabled and ScriptRunning then
        local targetHead = GetClosestEnemyInFOV()
        if targetHead then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
            -- Smooth Aiming menggunakan CFrame Lerp
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Config.AimbotSmoothness)
        end
    end
end))

-- ==========================================
-- LOGIKA ESP / WALLHACK
-- ==========================================
local function ApplyEsp(player, char)
    if not char or player == LocalPlayer then return end
    
    local head = char:WaitForChild("Head", 5)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not head or not hrp then return end

    if char:FindFirstChild("NeftishEsp") then char.NeftishEsp:Destroy() end

    local container = Instance.new("Folder")
    container.Name = "NeftishEsp"
    container.Parent = char

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.Adornee = head
    billboard.AlwaysOnTop = true
    billboard.ExtentsOffset = Vector3.new(0, 2.5, 0)
    billboard.Parent = container

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 60, 60)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextSize = 13
    label.Font = Enum.Font.SourceSansBold
    label.Parent = billboard

    local highlight = Instance.new("Highlight")
    highlight.Name = "EspOutline"
    highlight.Adornee = char
    highlight.FillTransparency = 1
    highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = container

    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not char or not char.Parent or not container or not container.Parent or not ScriptRunning then
            if conn then conn:Disconnect() end
            return
        end

        local shouldShow = Config.EspEnabled and (not Config.EspTeamCheck or IsEnemy(player))
        
        billboard.Enabled = shouldShow
        highlight.Enabled = shouldShow

        if shouldShow then
            pcall(function()
                local myChar = LocalPlayer.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myHrp and hrp then
                    local dist = math.floor((myHrp.Position - hrp.Position).Magnitude)
                    label.Text = (player.DisplayName or player.Name) .. " [" .. tostring(dist) .. "m]"
                else
                    label.Text = player.DisplayName or player.Name
                end
            end)
        end
    end)
    table.insert(Connections, conn)
end

local function MonitorPlayer(player)
    if player == LocalPlayer then return end
    if player.Character then task.spawn(ApplyEsp, player, player.Character) end
    table.insert(Connections, player.CharacterAdded:Connect(function(char)
        task.spawn(ApplyEsp, player, char)
    end))
end

for _, p in pairs(Players:GetPlayers()) do MonitorPlayer(p) end
table.insert(Connections, Players.PlayerAdded:Connect(MonitorPlayer))

