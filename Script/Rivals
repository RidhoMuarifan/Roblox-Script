local function CleanupScript()
    if not ScriptRunning then return end
    ScriptRunning = false
    FovCircle.Visible = false
    pcall(function() FovCircle:Remove() end)
    
    for _, conn in pairs(Connections) do
        if conn then pcall(function() conn:Disconnect() end) end
    end
    
    pcall(function() MenuGui:Destroy() end)
    pcall(function() FloatingGui:Destroy() end)
    
    if _G.NeftishRivalsCleanup == CleanupScript then
        _G.NeftishRivalsCleanup = nil
    end
end

_G.NeftishRivalsCleanup = CleanupScript

CloseBtn.MouseButton1Click:Connect(function() ConfirmFrame.Visible = true end)
YesBtn.MouseButton1Click:Connect(function() CleanupScript() end)
NoBtn.MouseButton1Click:Connect(function() ConfirmFrame.Visible = false end)
