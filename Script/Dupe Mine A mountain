-- ------------------------------------------
-- TAB 3: AUTO CRYSTAL (DROPPER & PICKUP)
-- ------------------------------------------
-- Groupbox Kiri: Auto Select Drop
local DropBox = AutoCrystalTab:AddLeftGroupbox("Auto Select Drop", "arrow-down-from-line")
local DropDropdownObj

DropBox:AddButton("Scan Backpack Drop", function()
    scanBackpackForDrop()
    table.clear(DropdownDropMap)
    
    local options = {}
    for nameKey, data in pairs(BackpackDropCrystals) do
        local optionStr = string.format("%s [%dx]", nameKey, data.Count)
        table.insert(options, optionStr)
        DropdownDropMap[optionStr] = nameKey
    end
    
    if #options == 0 then
        table.insert(options, "(Backpack Kosong)")
        SelectedDropGroup = nil
    end
    
    if DropDropdownObj then
        DropDropdownObj:SetValues(options)
        DropDropdownObj:SetValue(options[1])
    end
    
    Library:Notify(string.format("Ditemukan %d jenis kristal di tas", #options), 3)
end)

DropDropdownObj = DropBox:AddDropdown("SelectiveDropDropdown", {
    Values = {"(Tekan Scan Backpack Drop)"},
    Default = 1,
    Multi = false,
    Text = "Pilih Kristal Drop",
    Callback = function(Option)
        SelectedDropGroup = DropdownDropMap[Option] or Option
    end,
})

DropBox:AddInput("DropAmountInput", {
    Default = "1", Numeric = true, Finished = false,
    Text = "Jumlah Drop",
    Tooltip = "Masukkan jumlah kristal yang mau dibuang",
    Callback = function(Value)
        local num = tonumber(Value)
        if num and num > 0 then
            DropAmount = math.floor(num)
        else
            DropAmount = 1
        end
    end,
})

DropBox:AddButton("Drop Crystal", function()
    if IsDropping then
        Library:Notify("Tunggu proses drop selesai!", 2)
        return
    end

    if not SelectedDropGroup or not BackpackDropCrystals[SelectedDropGroup] then
        Library:Notify("Error: Pilih kristal dari dropdown terlebih dahulu!", 3)
        return
    end

    dropCrystalsViaRemote(SelectedDropGroup, DropAmount)
end)

-- Groupbox Kanan: Auto Pickup Crystal
local FarmBox = AutoCrystalTab:AddRightGroupbox("Auto Pickup Crystal", "crosshair")

FarmBox:AddDropdown("RarityFilterDropdown", {
    Values = TIER_LIST,
    Default = 1,
    Multi = false,
    Text = "Filter Tier / Rarity",
    Callback = function(Option)
        SelectedRarityFilter = Option
    end,
})

local CrystalDropdownObj

FarmBox:AddButton("Scan World Crystals", function()
    scanWorld()
    table.clear(DropdownMap)
    
    local options = {}
    for nameKey, data in pairs(ScannedCrystals) do
        local optionStr = string.format("%s [x%d]", nameKey, data.Count)
        table.insert(options, optionStr)
        DropdownMap[optionStr] = nameKey
    end
    
    if #options == 0 then
        table.insert(options, "(Tidak Ada Kristal " .. SelectedRarityFilter .. ")")
        SelectedTargetKey = nil
    end
    
    if CrystalDropdownObj then
        CrystalDropdownObj:SetValues(options)
        CrystalDropdownObj:SetValue(options[1])
    end
    
    Library:Notify(string.format("Scan Selesai: %d jenis kristal (%s)", #options, SelectedRarityFilter), 3)
end)

CrystalDropdownObj = FarmBox:AddDropdown("CrystalTargetDropdown", {
    Values = {"(Tekan Scan World Terlebih Dahulu)"},
    Default = 1,
    Multi = false,
    Text = "Pilih Target Kristal",
    Callback = function(Option)
        SelectedTargetKey = DropdownMap[Option] or Option
    end,
})

FarmBox:AddToggle("StartGlideFarmToggle", {
    Text = "Start Glide & Auto Pickup",
    Default = false,
    Callback = function(Value)
        IsGliding = Value
        
        if not Value then
            stopGlide()
            if CurrentGlideThread then task.cancel(CurrentGlideThread) end
            return
        end

        if not SelectedTargetKey or not ScannedCrystals[SelectedTargetKey] then
            Library:Notify("Error: Pilih kristal dari dropdown terlebih dahulu!", 3)
            return
        end

        local root = getRoot()
        if root then
            InitialCFrame = root.CFrame
        end

        enableNoclip()

        CurrentGlideThread = task.spawn(function()
            local groupData = ScannedCrystals[SelectedTargetKey]
            
            while IsGliding and groupData and #groupData.Instances > 0 do
                local crystalPart = groupData.Instances[#groupData.Instances]
                
                if crystalPart and crystalPart.Parent then
                    local targetPos = crystalPart.Position + Vector3.new(0, 1, 0)
                    local targetCFrame = CFrame.new(targetPos, crystalPart.Position)
                    
                    while IsGliding and crystalPart.Parent do
                        local deltaTime = task.wait(0.01)
                        local currentRoot = getRoot()
                        if not currentRoot then break end
                        
                        glideToCFrame(targetCFrame, deltaTime)
                        executeAreaPickup()

                        if not crystalPart.Parent then break end
                    end
                end

                table.remove(groupData.Instances, #groupData.Instances)
                groupData.Count = #groupData.Instances
            end

            if IsGliding and InitialCFrame then
                Library:Notify("Terbang kembali ke posisi awal...", 3)
                
                while IsGliding do
                    local deltaTime = task.wait(0.01)
                    local currentRoot = getRoot()
                    if not currentRoot then break end
                    
                    glideToCFrame(InitialCFrame, deltaTime)
                    executeAreaPickup()

                    if (currentRoot.Position - InitialCFrame.Position).Magnitude <= 3 then
                        break
                    end
                end
            end

            stopGlide()
            Library:Notify("Selesai! Semua kristal dipanen & kembali ke posisi awal.", 3)
        end)
    end,
})

-- ------------------------------------------
-- TAB 4: INVENTORY & UTILITIES
-- ------------------------------------------
local InvBox = InvTab:AddLeftGroupbox("Isi Backpack (Auto-Group)", "package")
local ItemLabels = {}

local function updateBackpackUI()
    for _, lbl in ipairs(ItemLabels) do
        lbl:SetText("")
    end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return end

    local itemCounts = {}
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            local cleanName = cleanItemName(item.Name)
            itemCounts[cleanName] = (itemCounts[cleanName] or 0) + 1
        end
    end

    local index = 1
    for name, count in pairs(itemCounts) do
        local textString = string.format("%s [x%d]", name, count)
        
        if not ItemLabels[index] then
            ItemLabels[index] = InvBox:AddLabel(textString)
        else
            ItemLabels[index]:SetText(textString)
        end
        index = index + 1
    end

    if index == 1 then
        if not ItemLabels[1] then
            ItemLabels[1] = InvBox:AddLabel("(Backpack Kosong)")
        else
            ItemLabels[1]:SetText("(Backpack Kosong)")
        end
    end
end

